# =========================================================
# Impactive production environment
# Copy to .env and replace every placeholder.
# Never commit .env.
# =========================================================

# Public application URLs
AUTH_TRUST_HOST=true
FRONT_END_HOST=https://imp-active.it
FRONT_END_ADMIN_HOST=https://admin.imp-active.it
NEXTAUTH_URL_USER=https://imp-active.it
NEXTAUTH_URL=https://admin.imp-active.it

# User frontend authentication
NEXTAUTH_SECRET_USER=REPLACE_WITH_RANDOM_SECRET
KEYCLOAK_CLIENT_SECRET_USER=REPLACE_WITH_USER_CLIENT_SECRET
KEYCLOAK_CLIENT_ID_USER=REPLACE_WITH_USER_CLIENT_ID
KEYCLOAK_ISSUER_USER=https://auth.imp-active.it/realms/REPLACE_WITH_USER_REALM

# Admin frontend authentication
NEXTAUTH_SECRET=REPLACE_WITH_RANDOM_SECRET
KEYCLOAK_CLIENT_SECRET=REPLACE_WITH_ADMIN_CLIENT_SECRET
KEYCLOAK_CLIENT_ID=REPLACE_WITH_ADMIN_CLIENT_ID
KEYCLOAK_ISSUER=https://auth.imp-active.it/realms/REPLACE_WITH_ADMIN_REALM

# Keycloak server and bootstrap admin
KEYCLOAK_URL=http://keycloak:8080
KC_BOOTSTRAP_ADMIN_USERNAME=REPLACE_WITH_KEYCLOAK_ADMIN
KC_BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# Keycloak PostgreSQL
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD

# Keycloak realms and clients
KEYCLOAK_USERS_REALM=REPLACE_WITH_USER_REALM
KEYCLOAK_USERS_CLIENT_ID=REPLACE_WITH_USER_CLIENT_ID
KEYCLOAK_USERS_SECRET=REPLACE_WITH_USER_CLIENT_SECRET
KEYCLOAK_ADMIN_REALM=REPLACE_WITH_ADMIN_REALM
KEYCLOAK_ADMIN_CLIENT_ID=REPLACE_WITH_ADMIN_CLIENT_ID
KEYCLOAK_ADMIN_SECRET=REPLACE_WITH_ADMIN_CLIENT_SECRET
KEYCLOAK_ADMIN_ISSUER=https://auth.imp-active.it/realms/REPLACE_WITH_ADMIN_REALM
KEYCLOAK_ADMIN_ISSUER_BACKEND_USER=https://auth.imp-active.it/realms/REPLACE_WITH_USER_REALM

# User MongoDB
MONGO_HOST=mongodb_service
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=impactive_user
MONGO_INITDB_ROOT_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MONGO_INITDB_DATABASE=impactive

# Admin MongoDB
MONGO_ADMIN_USER=impactive_admin
MONGO_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
MONGO_DB_ADMIN=impactive_admin

# Admin development MongoDB
MONGO_ADMIN_USER_DEV=impactive_admin_dev
MONGO_ADMIN_PASSWORD_DEV=REPLACE_WITH_RANDOM_PASSWORD
MONGO_DB_ADMIN_DEV=impactive_admin_dev

# Legacy backup variable: reconcile with MONGO_DB_ADMIN
MONGO_DB=impactive_admin

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_DEFAULT_USER=impactive
RABBITMQ_DEFAULT_PASS=REPLACE_WITH_RANDOM_PASSWORD
QUESTIONNAIRE_QUEUE=questionnaire

# SMTP: configure with your actual provider
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD



# Database backup and encryption
BACKUP_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_ENCRYPTION_KEY




# Cloudflare R2 backups
R2_ENABLED=true
R2_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
R2_ENDPOINT=https://REPLACE_WITH_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=REPLACE_WITH_BUCKET_NAME
R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY
R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_KEY




# Grafana
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
